---
import { ChevronDown } from 'lucide-react';
import type { Duvida } from '../../lib/types';

interface Props {
  duvida: Duvida;
}

const { duvida } = Astro.props;
---

<details
  class="group bg-white rounded-xl px-5 py-4 border border-slate-100 dark:bg-[#1a1a1a] dark:border-[#262626] transition-all duration-300 hover:-translate-y-1 hover:shadow-md dark:hover:shadow-none dark:hover:border-[#3b82f6]/50"
>
  <summary class="flex items-center justify-between font-medium text-slate-900 dark:text-[#fafafa]">
    {duvida.pergunta}
    <span class="faq-chevron text-brand-500 transition-transform dark:text-[#3b82f6]">
      <ChevronDown className="w-4 h-4" />
    </span>
  </summary>
  <p class="text-sm text-slate-500 mt-3 leading-relaxed dark:text-[#a3a3a3]">{duvida.resposta}</p>
</details>
