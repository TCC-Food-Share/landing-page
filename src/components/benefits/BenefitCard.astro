---
import { Clock, Gift, Recycle, Users } from 'lucide-react';
import type { Beneficio } from '../../lib/types';

interface Props {
  beneficio: Beneficio;
}

const { beneficio } = Astro.props;

const icones = { gift: Gift, clock: Clock, recycle: Recycle, users: Users };
const temas = {
  brand: 'bg-brand-100 text-brand-700',
  leaf: 'bg-leaf-50 text-leaf-700',
  amber: 'bg-amber-50 text-amber-700',
};

const Icone = icones[beneficio.icone];
---

<div
  class="bg-slate-50 rounded-2xl p-6 dark:bg-[#1a1a1a] dark:border dark:border-[#262626] hover-lift hover:-translate-y-1.5 hover:shadow-lg dark:hover:shadow-none dark:hover:border-[#3b82f6]/50"
  data-aos="fade-up"
  data-aos-delay={beneficio.atraso}
>
  <div
    class:list={[
      'w-11 h-11 rounded-full flex items-center justify-center mb-4 dark:bg-[#1a2744] dark:text-[#3b82f6]',
      temas[beneficio.temaIcone],
    ]}
  >
    <Icone className="w-5 h-5" />
  </div>
  <h3 class="font-display font-semibold text-slate-900 mb-1 dark:text-[#fafafa]">{beneficio.titulo}</h3>
  <p class="text-sm text-slate-500 leading-relaxed dark:text-[#a3a3a3]">{beneficio.descricao}</p>
</div>
