---
import { HeartHandshake, Store } from 'lucide-react';
import { urlCadastroEntidade, urlCadastroEstabelecimento } from '../../data/app';

const perfis = [
  {
    Icone: Store,
    titulo: 'Sou estabelecimento',
    descricao: 'Doe os excedentes do seu negócio para entidades da sua região, sem custo.',
    href: urlCadastroEstabelecimento,
    acao: 'Quero doar',
    atraso: 0,
  },
  {
    Icone: HeartHandshake,
    titulo: 'Sou entidade beneficiária',
    descricao: 'Encontre alimentos disponíveis perto de você e solicite em poucos cliques.',
    href: urlCadastroEntidade,
    acao: 'Quero receber',
    atraso: 100,
  },
];
---

<section id="cadastro" class="max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20">
  <div
    class="bg-linear-to-br/srgb from-brand-600 to-brand-800 rounded-3xl px-6 py-12 sm:px-8 sm:py-14 text-center dark:border dark:border-[#262626]"
    data-aos="zoom-in"
  >
    <h2 class="font-display font-bold text-2xl sm:text-3xl text-white mb-3">Pronto para fazer parte?</h2>
    <p class="text-brand-100 mb-10 max-w-md mx-auto">
      Escolha seu perfil e crie sua conta gratuita. Leva menos de um minuto.
    </p>

    <div class="grid sm:grid-cols-2 gap-4 sm:gap-5 max-w-3xl mx-auto">
      {
        perfis.map(({ Icone, titulo, descricao, href, acao, atraso }) => (
          <a
            href={href}
            class="group flex flex-col items-center sm:items-start text-center sm:text-left bg-white/10 border border-white/20 rounded-2xl p-6 hover:bg-white/15 hover-lift hover:-translate-y-1"
            data-aos="fade-up"
            data-aos-delay={atraso}
          >
            <span class="w-11 h-11 shrink-0 rounded-full bg-white/15 text-white flex items-center justify-center mb-4">
              <Icone className="w-5 h-5" />
            </span>
            <span class="font-display font-semibold text-lg text-white mb-2">{titulo}</span>
            <span class="text-sm text-brand-100 leading-relaxed mb-6">{descricao}</span>
            <span class="mt-auto inline-block bg-white text-brand-800 font-semibold px-5 py-2.5 rounded-lg group-hover:bg-brand-50 transition-colors dark:bg-[#fafafa] dark:group-hover:bg-white">
              {acao}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
